{
  "name": "@shader-playground/xr-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "codegen": "node scripts/gen-shader.mjs",
    "codegen:check": "node scripts/gen-shader.mjs --check",
    "build": "pnpm run codegen && tsc -p tsconfig.build.json && node scripts/inject-webgpu-types-ref.mjs && node scripts/verify-no-raw-import.mjs"
  },
  "dependencies": {
    "@shader-playground/avp-gestures": "workspace:*"
  },
  "peerDependencies": {
    "@webgpu/types": "^0.1.69"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69"
  }
}
